# Create /dev/lcn-pku as a real character device node (0660 root:dialout) matching the FTDI (0403:6001) LCN-PKU USB serial coupler's major:minor
ACTION=="add", SUBSYSTEM=="tty", ENV{ID_BUS}=="usb", ENV{ID_VENDOR_ID}=="0403", ENV{ID_MODEL_ID}=="6001", RUN+="/bin/sh -c 'rm -f /dev/lcn-pku && mknod -m 0660 /dev/lcn-pku c $major $minor && chgrp dialout /dev/lcn-pku'"
ACTION=="remove", SUBSYSTEM=="tty", ENV{ID_BUS}=="usb", ENV{ID_VENDOR_ID}=="0403", ENV{ID_MODEL_ID}=="6001", RUN+="/bin/rm -f /dev/lcn-pku"
