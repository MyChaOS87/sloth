# Create /dev/lcn-pku as a real character device node (0660 root:dialout) matching the USB serial coupler's major:minor
ACTION=="add", SUBSYSTEM=="tty", ENV{ID_BUS}=="usb", RUN+="/bin/sh -c 'rm -f /dev/lcn-pku && mknod -m 0660 /dev/lcn-pku c $major $minor && chgrp dialout /dev/lcn-pku'"
ACTION=="remove", SUBSYSTEM=="tty", ENV{ID_BUS}=="usb", RUN+="/bin/rm -f /dev/lcn-pku"
